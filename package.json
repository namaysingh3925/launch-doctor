{
  "name": "launch-doctor",
  "version": "0.2.0",
  "description": "A pre-launch checkup for vibe-coded apps. Grades your project A-F on secrets, database safety, payments, AI costs, email, error tracking, legal pages and first impressions, with a copy-paste fix prompt for every issue.",
  "type": "module",
  "bin": {
    "launch-doctor": "dist/src/cli.js"
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/src/cli.js",
    "doctor": "npm run build && node dist/src/cli.js",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/namaysingh3925/launch-doctor.git"
  },
  "bugs": {
    "url": "https://github.com/namaysingh3925/launch-doctor/issues"
  },
  "homepage": "https://github.com/namaysingh3925/launch-doctor#readme",
  "keywords": [
    "launch-readiness",
    "production-readiness",
    "vibe-coding",
    "security",
    "secrets",
    "supabase",
    "stripe",
    "firebase",
    "nextjs",
    "lovable",
    "cursor",
    "claude-code",
    "sarif",
    "cli"
  ],
  "author": "Namay Singh",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
